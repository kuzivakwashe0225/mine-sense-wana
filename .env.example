# Copy to .env and fill in. Generate each secret with:  openssl rand -hex 24
# Never commit .env.

# Public address of the app (no trailing slash). Sign-in lives at $WANA_PUBLIC_URL/auth.
WANA_PUBLIC_URL=https://minesense-wana.meshcloud.co.zw
WANA_DOMAIN=minesense-wana.meshcloud.co.zw
WANA_PORT=8095
# Gets an administrator account on first start and the set-password email.
WANA_ADMIN_EMAIL=kuzyzeeke@gmail.com

# Session policy (seconds): sign out after idle, warn before, how long reading counts as activity
WANA_IDLE_SECONDS=900
WANA_WARN_SECONDS=60
WANA_READING_SECONDS=1800

# Keycloak
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=
KC_DB_PASSWORD=
WANA_KC_BACKEND_SECRET=

# Redis, MinIO
REDIS_PASSWORD=
MINIO_ROOT_USER=wana-root
MINIO_ROOT_PASSWORD=
MINIO_APP_USER=wana-app
MINIO_APP_PASSWORD=

# Email. Keycloak sends through Mailpit (UI on 127.0.0.1:8026). To deliver for real, relay through an SMTP
# account, e.g. Gmail with an App Password (Google Account > Security > App passwords):
WANA_MAIL_FROM=kuzyzeeke@gmail.com
MAILPIT_UI_USER=admin
MAILPIT_UI_PASSWORD=
WANA_SMTP_RELAY_ALL=false
WANA_SMTP_RELAY_HOST=
WANA_SMTP_RELAY_PORT=587
WANA_SMTP_RELAY_AUTH=plain
WANA_SMTP_RELAY_USERNAME=
WANA_SMTP_RELAY_PASSWORD=

# Monitoring (127.0.0.1 only: Grafana :3110, Prometheus :9190)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
